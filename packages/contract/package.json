{
  "name": "@azvf/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "安装协议契约：资源元数据、会话请求/响应、令牌契约、设备标识符、表盘 ID 字段与分片尺寸约定",
  "main": "./dist/index.js",
