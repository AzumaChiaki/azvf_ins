{
  "name": "@azvf/reference-authorizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Local-only reference implementation of the AZVF Installer authorizer protocol",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
