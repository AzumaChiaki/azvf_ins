# ---- Installer 服务配置 ----
NODE_ENV=production
PORT=4002
HOST=127.0.0.1

# 反向代理终止 TLS 时开启，并将 Installer 仅绑定到内网/loopback。
TRUST_PROXY=true
REQUIRE_HTTPS=true
CORS_ORIGINS=https://installer.example.com
# 默认均留空并上报 UNKNOWN。前两项必须同时设置；应用先验证 raw socket
# immediate peer。OpenResty 与 Node 同机时可使用 x-azvf-region 和
# 127.0.0.1/32,::1/128，不要把客户端网段写入 immediate peer 列表。
TRUSTED_REGION_HEADER=
TRUSTED_REGION_PROXY_CIDRS=
# 两跳代理拓扑必须同时设置下面两项。OpenResty 必须用 `$realip_remote_addr` 强制覆盖
# x-azvf-edge-peer，并强制覆盖 x-azvf-region，不能透传客户端同名头；
# 生产同机反代可使用 TRUSTED_REGION_EDGE_PEER_HEADER=x-azvf-edge-peer。
TRUSTED_REGION_EDGE_PEER_HEADER=
# 逗号分隔边缘代理 IPv4/IPv6 CIDR；应使用供应商当前官方列表并定期更新。
TRUSTED_REGION_EDGE_CIDRS=

# Console 使用 Ed25519 私钥签发；Installer 仅持 SPKI 公钥（DER base64）。
TOKEN_ISSUER=azvf-console
TOKEN_AUDIENCE=azvf-installer
JWT_ED25519_PUBLIC_KEY_B64=
JWT_KEY_ID=azvf-auth-2026-01
# 轮换时改用 JSON keyring 并保留仍有资源 manifest 的旧公钥：{"kid":"SPKI_DER_BASE64"}
# JWT_ED25519_PUBLIC_KEYS_JSON={"azvf-auth-2026-01":"...","azvf-auth-2026-02":"..."}
JWT_MAX_AGE_SECONDS=600
JWT_CLOCK_TOLERANCE_SECONDS=5

# HS256 只用于短期迁移。生产切换 EdDSA 后必须保持 false 并删除 JWT_SECRET。
JWT_ALLOW_LEGACY_HS256=false
JWT_SECRET=

# Installer → Console 必须使用 HTTPS，并对每次请求及资源响应做 HMAC 绑定。
CONSOLE_URL=https://console.internal.example.com/
INTERNAL_SIGNING_KEY_B64=
INTERNAL_KEY_ID=v1
INTERNAL_CLIENT_ID=installer
INTERNAL_CLOCK_SKEW_MS=30000
INTERNAL_REQUEST_TIMEOUT_MS=30000
# 资源流只限制“等待响应头”和“连续无字节”，不限制整个大文件的传输时长。
INTERNAL_STREAM_IDLE_TIMEOUT_MS=60000
# 下游 BLE 回压期间允许的上游空闲窗口上限;窗口随会话剩余租约动态伸缩。
INSTALL_STREAM_STALL_MAX_MS=300000
ALLOW_INSECURE_INTERNAL_HTTP=false

# 资源协议始终启用认证加密；不存在明文/CHUNK_ENCRYPTION 降级开关。
SESSION_TTL=600
INSTALL_LEASE_TTL=900
INSTALL_MAX_DURATION=3600
MAX_RESOURCE_BYTES=1073741824
MAX_META_BYTES=8388608
DECOY_RATIO=0.10

# SQLite 持久化一次性 jti 与安装 lease。
INSTALLER_DATA_DIR=./data/installer
INSTALLER_DB_PATH=./data/installer/installer.sqlite

# 严格阶梯并发：同一设备始终 1，同一授权默认 1。
INSTALL_GLOBAL_CONCURRENCY=32
INSTALL_IP_CONCURRENCY=8
INSTALL_ENTITLEMENT_CONCURRENCY=1
INSTALL_TIER_BASIC=1
INSTALL_TIER_STANDARD=2
INSTALL_TIER_PREMIUM=4
INSTALL_TIER_INTERNAL=8

API_RATE_LIMIT_PER_MINUTE=120
SESSION_RATE_LIMIT_PER_MINUTE=10
MAX_BODY_BYTES=32768

# `pnpm build` 生成 dist-web，生产服务同源托管该目录。
SERVE_STATIC=true
INSTALLER_STATIC_DIR=./dist-web

# 核销页地址。服务端要求安装页回去重新核销时，用它下达跳转指令
# （X-AZVF-Reauth）。只接受同源绝对路径或完整 HTTP(S) 地址；
# 与前端 window.__AZVF_RUNTIME__.redeemUrl 保持一致。
REDEEM_URL=/
